# SatyaSetu Frontend Environment Variables (Vercel)

# Target Render backend service URL for Next.js API proxying / rewrites
BACKEND_API_URL=https://satyasetu-xvk9.onrender.com

# Public direct API base URL (optional, defaults to BACKEND_API_URL/api/v1 or /api/v1)
NEXT_PUBLIC_API_URL=https://satyasetu-xvk9.onrender.com/api/v1

# Public application branding
NEXT_PUBLIC_APP_NAME=SatyaSetu
