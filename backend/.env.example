# Service Configuration
SERVICE_NAME=sachcheck-backend
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server & Networking
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security
SECRET_KEY=sachcheck-foundation-secret-key-change-in-production
API_KEY_HEADER_NAME=X-API-Key
