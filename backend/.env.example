# Service Configuration
SERVICE_NAME=sachcheck-backend
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server & Networking
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security
SECRET_KEY=sachcheck-foundation-secret-key-change-in-production
API_KEY_HEADER_NAME=X-API-Key

# Firebase / Cloud Firestore Persistence (Never hardcode credentials in code)
FIREBASE_PROJECT_ID=sachcheck-prod
# Optional: Path to serviceAccountKey.json
FIREBASE_CREDENTIALS_PATH=
# Optional: Base64 or JSON string of service account key (useful for cloud deployments)
FIREBASE_CREDENTIALS_JSON=
# Optional: Named database ID (default is "(default)")
FIRESTORE_DATABASE_ID=(default)
# Optional: Firestore emulator host (e.g., localhost:8080 for local testing)
FIRESTORE_EMULATOR_HOST=

# Sarvam AI Speech-to-Text (Indian Vernacular: en-IN, hi-IN, mr-IN)
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text
MAX_VOICE_DURATION_SECONDS=60.0

# Evidence Retrieval Providers
# Google Fact Check Tools API Key
GOOGLE_FACT_CHECK_API_KEY=
# Tavily Search API Key
TAVILY_API_KEY=
SEARCH_PROVIDER=tavily

# Twilio WhatsApp Webhook & Messaging Integration
# Twilio Account SID & Auth Token (Keep secrets confidential; never commit real tokens)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender WhatsApp number (e.g. sandbox 'whatsapp:+14155238886' or approved business profile)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Validate Twilio signature on webhook requests (true in staging/production, set false to bypass in local dev)
TWILIO_VALIDATE_SIGNATURE=true
# Max timeout when downloading media attachments (in seconds)
TWILIO_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=15.0
# Public base URL used for "View full evidence" links in citizen WhatsApp replies
BASE_PUBLIC_URL=https://sachcheck.in
