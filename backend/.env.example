# SatyaSetu Backend Environment Configuration (Render / Production)

# Service Identity
SERVICE_NAME=satyasetu-backend
VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Server & Networking
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["https://satyasetu.vercel.app","http://localhost:3000"]

# Session & JWT Security
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
API_KEY_HEADER_NAME=X-API-Key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# Twilio Verify & WhatsApp Messaging (Backend Only - Never expose to frontend)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VA_your_verify_service_sid
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_ASYNC_DISPATCH=true
BASE_PUBLIC_URL=https://satyasetu.vercel.app

# AI Model Extraction Providers
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
DEMO_MODE=false

# Authoritative Evidence Retrieval
TAVILY_API_KEY=your_tavily_search_api_key
SEARCH_PROVIDER=tavily
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key

# Optional Speech-to-Text & Vernacular Audio (Sarvam AI)
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_API_URL=https://api.sarvam.ai/text-to-speech
SARVAM_TTS_MODEL=bulbul:v3

# Cloud Firestore Persistence (Optional - InMemory fallback active when not configured)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
FIRESTORE_DATABASE_ID=(default)
